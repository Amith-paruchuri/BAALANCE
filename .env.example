# BAALANCE environment configuration
# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# --- Supabase (Auth + Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Sign-in providers are enabled in Supabase → Authentication → Providers:
#   Google: add calendar scope consent in Google Cloud (OAuth consent screen).
#   Azure (Microsoft): create an app registration in Microsoft Entra ID,
#     redirect URI https://your-project.supabase.co/auth/v1/callback,
#     supported accounts "any organization + personal Microsoft accounts",
#     delegated Graph permissions User.Read and Calendars.ReadWrite,
#     then paste the client ID, secret and tenant URL https://login.microsoftonline.com/common
#     into the Azure provider in Supabase.

# --- AI provider ---
# gemini | azure | auto (auto = first configured, the other as fallback)
AI_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Azure OpenAI (Azure AI Foundry): a vision-capable chat deployment such as gpt-4o or gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
