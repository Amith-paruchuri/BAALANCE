# BAALANCE environment configuration
# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# --- Supabase (Auth + Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Sign-in providers are enabled in Supabase → Authentication → Providers:
#   Google: add calendar scope consent in Google Cloud (OAuth consent screen).
#   Azure (Microsoft): create an app registration in Microsoft Entra ID,
#     redirect URI https://your-project.supabase.co/auth/v1/callback,
#     supported accounts "any organization + personal Microsoft accounts",
#     delegated Graph permissions User.Read and Calendars.ReadWrite,
#     then paste the client ID, secret and tenant URL https://login.microsoftonline.com/common
#     into the Azure provider in Supabase.

# --- AI: Azure OpenAI only ---
# Azure OpenAI (Azure AI Foundry): a vision-capable chat deployment such as gpt-4o or gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Content Safety: second safety check on Tricha chat (messages and replies).
# Without these, the built-in crisis rule check still runs.
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=

# Optional: lets "Delete my data" also remove the sign-in account itself.
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Azure Maps: lists doctors near the user in the Get help panel (Search POI).
# Without it, the panel opens a map search instead. Server only.
AZURE_MAPS_KEY=

# Azure AI Search: optional. Runs Tricha's evidence retrieval (RAG) on Azure AI Search
# instead of the built-in keyword search. The app creates and fills the index itself,
# so the key must be an ADMIN key (Search service > Settings > Keys).
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=baalance-evidence

# Microsoft Foundry Agent Service (Tricha as a hosted agent). Optional: without it,
# Tricha runs as a direct Azure OpenAI tool-calling agent.
# Project endpoint from Foundry portal > project Overview.
FOUNDRY_PROJECT_ENDPOINT=
# Entra app registration (service principal) with the Azure AI User role on the project.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional
FOUNDRY_AGENT_NAME=tricha
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
